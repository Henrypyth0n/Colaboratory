            const result = await google.colab.kernel.invokeFunction('get_wasm_data', [], {});
            const base64Data = result.data['text/plain'].replace(/'/g, "");

            if (!base64Data || base64Data.length < 10) {
                throw new Error("WASM binary is empty or not found. Build it in the Forge!");
            }

            // 2. CONVERT BASE64 TO BYTES
            const binaryString = window.atob(base64Data);
            const bytes = new Uint8Array(binaryString.length);
            for (let i = 0; i < binaryString.length; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            // Manually lock the theater to a strict 31 Megabyte grid
            const classic90sMemory = new WebAssembly.Memory({
                initial: 500, // Start with exactly 31.25 MB (500 pages)
                maximum: 500  // Hard Ceiling! .grow() will completely fail if triggered.
            });
            // 3. DEFINE THE IMPORTS (The "Bridge")
            function readString(ptr, len) {
                const bytes = new Uint8Array(currentEngine.memory.buffer, ptr, len);
                return new TextDecoder().decode(bytes);
            }

            const importObject = {
                env: {
                    // First set of tools
                    println: (ptr, len) => {
                        const mem = new Uint8Array(currentEngine.memory.buffer);
                        const text = new TextDecoder().decode(mem.subarray(ptr, ptr + len));

                        // Check if the incoming string contains our protocol delimiter
                        if (text.includes('~')) {
                            // Split the string into an array: [id, color, msg]
                            const parts = text.split('~');

                            const logId = parts[0].trim();
                            const textColor = parts[1].trim();
                            const message = parts[2];

                            // Feed the extracted pieces straight into your logToSim function!
                            logToSim(`<b>RUST:</b> ${message}`, textColor, logId);
                        } else {
                            // Fallback for standard plain-text prints
                            logToSim(`<b>RUST:</b> ${text}`, "#fff", 'simLog');
                        }
                    },

                    // Second set of tools - put it right here in the same 'env'!
                    newin: (msgPtr, msgLen) => {
                        // 1. Read the prompt message from Rust
                        const mem = new Uint8Array(currentEngine.memory.buffer);
                        const message = new TextDecoder().decode(mem.subarray(msgPtr, msgPtr + msgLen));

                        // 2. Show the prompt
                        const userInput = prompt(message) || "";

                        // 3. Prepare the string for Rust
                        const encoder = new TextEncoder();
                        const encoded = encoder.encode(userInput + "\0"); // Null-terminated

                        // 4. Use the "Parking Spot" in Rust
                        const ptr = currentEngine.allocate_for_js(encoded.length);

                        // 5. Write the data into Rust's memory
                        const dest = new Uint8Array(currentEngine.memory.buffer, ptr, encoded.length);
                        dest.set(encoded);

                        // 6. Return the pointer so Rust knows where to look
                        return ptr;
                    },

                    confirm: (ptr, len) => {
                        const msg = readString(ptr, len);
                        const result = window.confirm(msg);
                        // confirm returns true/false. We return 1 or 0 to Rust.
                        return result ? 1 : 0;
                    },

                    get_random_int: (min, max) => {
                        return Math.floor(Math.random() * (max - min + 1)) + min;
                    },
                    syscall: (cmd, sub_cmd, ptr, len) => {
                        try {
                        if (ptr === 0 || len === 0 || isBusy === true) {
                            console.warn(`[Bridge] Invalid memory access attempted: ptr=${ptr}, len=${len}`);
                            return 0;
                        }
                        const msg = readString(ptr, len);
                        //console.error("syscall error:", e);
                        switch(cmd) {
                            case 1: // Console Dispatcher
                                switch(sub_cmd) {
                                    case 0: console.debug(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 1: console.info(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 2: console.warn(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 3: console.error(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 4: console.log(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 5: console.trace(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 6: console.time(`[Rust] ${msg}`); break;
                                    case 7: console.timeEnd(`[Rust] ${msg}`); break;
                                    case 8: console.assert(msg, `%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 9: console.count(`[Rust] ${msg}`); break;
                                    case 10: console.countReset(`[Rust] ${msg}`); break;
                                    case 11: console.group(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 12: console.groupEnd(); break;
                                    case 13: console.table(msg); break;
                                    case 14: console.dir(`[Rust] ${msg}`); break;
                                    case 15: console.dirxml(`[Rust] ${msg}`); break;
                                    case 16: console.groupCollapsed(`%c[Rust] ${msg}`, "color: #f74c00; font-weight: bold;"); break;
                                    case 17: console.profile(`[Rust] ${msg}`); break;
                                    case 18: console.profileEnd(`[Rust] ${msg}`); break;
                                    case 19: console.timeStamp(`[Rust] ${msg}`); break;
                                    case 20: console.clear(); break;
