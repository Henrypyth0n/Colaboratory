if (window.speechSynthesis.onvoiceschanged !== undefined) {
  window.speechSynthesis.onvoiceschanged = () => {
    // Voices are ready
  };
}

// Surprise Symphony Alarm (Haydn No. 94, 2nd movement style)
// Plays quiet, gentle chords building up to a sudden explosive blast
function playSurpriseSymphonyAlarm() {
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playTone(freq, startTime, duration, gainValue = 0.1) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'triangle';
        osc.frequency.value = freq;

        gain.gain.setValueAtTime(gainValue, audioCtx.currentTime + startTime);
        gain.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + startTime + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(audioCtx.currentTime + startTime);
        osc.stop(audioCtx.currentTime + startTime + duration);
    }

    // Play a gentle, quiet C-major motif (the "sleepy" part)
    playTone(261.63, 0.0, 0.4, 0.05); // C4
    playTone(329.63, 0.5, 0.4, 0.05); // E4
    playTone(392.00, 1.0, 0.4, 0.05); // G4
    playTone(261.63, 1.5, 0.6, 0.05); // C4

    // THE SURPRISE: Sudden massive chord blast (Full brass/timpani simulation) after 2.5 seconds
    setTimeout(() => {
        const surpriseTime = 0;
        // Massive chord cluster with high gain for maximum startling effect
        playTone(130.81, surpriseTime, 1.2, 0.5); // C3
        playTone(196.00, surpriseTime, 1.2, 0.5); // G3
        playTone(261.63, surpriseTime, 1.2, 0.5); // C4
        playTone(329.63, surpriseTime, 1.2, 0.5); // E4
        playTone(523.25, surpriseTime, 1.2, 0.5); // C5
    }, 2500);
}

function plotqasm(rawShotsData) {
    const terminalOutput = document.getElementById("simLog");

    // Create a wrapper container for this specific execution batch
    const container = document.createElement("div");
    container.style.cssText = "font-family: monospace; margin-bottom: 15px; line-height: 1.4;";
    container.innerHTML = "📊 Quantum Execution Results:<hr style='border: 0; border-top: 1px dashed #555; margin: 4px 0;'>";

    // 1. Grab all the states and sum up total shots
    const states = Object.keys(rawShotsData);
    let totalShots = 0;
    states.forEach(state => {
        totalShots += rawShotsData[state];
    });

    // 2. Loop through and draw the retro text-bar rows
    states.forEach(state => {
        const shotCount = rawShotsData[state];
        const probability = shotCount / totalShots;
        const percentage = (probability * 100).toFixed(1);

        // Build the layout row
        const row = document.createElement("div");
        row.style.display = "flex";
        row.style.alignItems = "center";
        row.style.gap = "10px";
        row.style.fontFamily = "monospace";

        // Label (|00⟩)
        const label = document.createElement("span");
        label.innerText = `|${state}⟩`;
        label.style.width = "40px";

        // Generate the retro text loading block bar (e.g., 20 characters max width)
        const barLength = 20;
        const filledChars = Math.round(probability * barLength);
        const emptyChars = barLength - filledChars;
        const textBar = "█".repeat(filledChars) + "░".repeat(emptyChars);

        // Bar container
        const barElement = document.createElement("span");
        barElement.innerText = `[${textBar}]`;
        barElement.style.color = "#00ffcc"; // Classic terminal cyan
        barElement.style.flexGrow = "1";

        // Stats text
        const valueText = document.createElement("span");
        valueText.innerText = `${shotCount} (${percentage}%)`;
        valueText.style.width = "100px";
        valueText.style.textAlign = "right";

        row.appendChild(label);
        row.appendChild(barElement);
        row.appendChild(valueText);

        container.appendChild(row);
    });

    // Append the retro block to the terminal view
    terminalOutput.appendChild(container);
}
