def promptGemini(model='gemini-2.5-flash-lite', prompt='say No prompt entered'):
    try:
        try:
          loadClientApi()
        except:
          Print("no api provided")
          return Print("No api provided")
        # Generate content
        res = client.models.generate_content(
            model=f'{model}',
            contents=f'{prompt}',
            config={
                'tools': GeminiPermissions
            }
        )
        token_count = client.models.count_tokens(
            model="gemini-2.5-flash-lite", contents=prompt
        )
        Print(f"Prompt Tokens: {token_count}")
        #9999-0
        Print(f"Response Tokens: {res.usage_metadata}")

        # Structure the log entry
        log_entry = {
            "id": len(GeminiLogs) + 1,
            "timestamp": datetime.now().strftime("%H:%M:%S"),
            "model": model,
            "prompt": prompt,
            "response": res.text
        }

        GeminiLogs.append(log_entry)
        return res.text
    except Exception as e:
        return f"Error: {e}"
output.register_callback('notebook.promptGemini', promptGemini)

def py_eval(code_with_prefix):
    # Strip the 'py~' prefix
    code = code_with_prefix.replace("py~", "")
    result = exec(f'''{code}''')
    if result is None:
        result = "No result use Print uppercase p to print to console"
    # Send result to console
    display(Javascript(f"logToSim('py: ' + String.raw`{result}`,'#00ddff','simLog')"))
    return result

def ssh_eval(cmd_with_prefix):
    # Strip the 'ssh~' prefix
    cmd = cmd_with_prefix.replace("sh~", "")
    # Use subprocess to run the shell command
    try:
        output = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT, env=os.environ.copy())
        result = output.decode('utf-8').strip()
    except Exception as e:
        result = f"{e}"

    # Send result to console
    display(Javascript(f"logToSim('sh: ' + String.raw`{result}`,'#00ffcc')"))
    return result

output.register_callback('notebook.py_eval', py_eval)
output.register_callback('notebook.ssh_eval', ssh_eval)
