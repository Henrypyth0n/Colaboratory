//O-P-T-I-M-I-Z-E=============================================================================================================
let myStringMemory = { ptr: null, len: 0 };

function updateStringInMemory(targetEngine, newText) {
    const encoder = new TextEncoder();
    const encodedBytes = encoder.encode(newText);
    const newLen = encodedBytes.length;

    if (myStringMemory.ptr === null) {
        // First execution baseline: Run standard initial allocation
        myStringMemory.ptr = targetEngine.exports.allocate_for_js(newLen);
        myStringMemory.len = newLen;
    } else {
        // ⚡ REALLOCATION ENGINE: Ask Rust to scale our existing address block
        console.log(`🔄 Requesting scaling for address [${myStringMemory.ptr}] from ${myStringMemory.len} to ${newLen} bytes...`);

        myStringMemory.ptr = targetEngine.exports.reallocate_for_js(
            myStringMemory.ptr,
            myStringMemory.len,
            newLen
        );
        myStringMemory.len = newLen;
    }

    // Target the newly adjusted memory boundaries precisely
    const rawMemoryBuffer = targetEngine.exports.memory.buffer;
    const memoryLockerZone = new Uint8Array(rawMemoryBuffer, myStringMemory.ptr, myStringMemory.len);

    // Overwrite the heap with your updated string payload
    memoryLockerZone.set(encodedBytes);

    console.log(`⚡ String updated successfully at address: [${myStringMemory.ptr}] (${myStringMemory.len} bytes)`);

    // Trigger your reader to verify the content transition
    targetEngine.exports.process_string(myStringMemory.ptr, myStringMemory.len);
}

function vector_read_smart(length, type = "i32", ) {
    // 1. Map of valid 16-bit and 32-bit architectural configurations
    const lensRegistry = {
        "u8": { View: Uint8Array,   bytesPerSlot: 1 ,ID: 1},
        "i8": { View: Int8Array,    bytesPerSlot: 1, ID:  5},
        "u16": { View: Uint16Array,  bytesPerSlot: 2, ID: 2},
        "i16": { View: Int16Array,   bytesPerSlot: 2 ,ID: 6},
        "u32": { View: Uint32Array,  bytesPerSlot: 4, ID: 3},
        "i32": { View: Int32Array,   bytesPerSlot: 4 ,ID: 7},
        "f32": { View: Float32Array, bytesPerSlot: 4, ID: 4},
        //"f64": { View: Float64Array, bytesPerSlot: 8 ,ID: 9},
    };

    // 2. Select the configuration (fallback to i32 if it's an unrecognized type)
    const config = lensRegistry[type] || lensRegistry["i32"];
    const typeId = config.ID;
    // 3. Request the pointer coordinate from the active Rust module
    const ptr = rustEngine.get_vector_pointer(typeId);

    // 4. Align the offset index strictly to the data type's byte width
    const startIndex = ptr / config.bytesPerSlot;
    const endIndex = startIndex + length;

    // 5. Open the dynamic live lens over the memory buffer
    const mem = new config.View(rustEngine.memory.buffer);
    const numbers = mem.subarray(startIndex, endIndex);

    console.log(`📡 Read [${type}] from address [${ptr}]:`, numbers);
    return numbers;
}
function masterBridgeRouter(action, length, dataType = "i32") {
    const targetEngine = window.rustEngine || window.currentEngine;
    if (!targetEngine) return;

    // 1. Core Architectural Registry (Tells JS how to read the hardware)
    const typeRegistry = {
        "u8":  { View: Uint8Array,    shift: 0 }, // 1 byte (no shift needed)
        "i16": { View: Int16Array,    shift: 1 }, // 2 bytes (ptr / 2)
        "u16": { View: Uint16Array,   shift: 1 }, // 2 bytes (ptr / 2)
        "i32": { View: Int32Array,    shift: 2 }, // 4 bytes (ptr / 4)
        "f32": { View: Float32Array,  shift: 2 }  // 4 bytes (ptr / 4)
    };

    const config = typeRegistry[dataType] || typeRegistry["i32"];

    // 2. Action Routing Deck (Having many functions inside one!)
    const routes = {
        // Function Route A: Read raw data arrays out of Rust Vectors
        "read": () => {
            const ptr = targetEngine.get_vector_pointer();
            const startIndex = ptr >> config.shift; // Blazing fast bitwise alignment
            const memView = new config.View(targetEngine.memory.buffer);
            return memView.subarray(startIndex, startIndex + length);
        },

        // Function Route B: Execute structural analytics passes
        "analyze": () => {
            console.log(`📊 Initializing analytics pass for type [${dataType}]`);
            targetEngine.inspect_complex_types();
            return "Pass Complete";
        },

        // Function Route C: Fire a safe execution loop sequence
        "loop_test": () => {
            return targetEngine.run_test_loop();
        }
    };

    // 3. Execute the matched route safely
    if (routes[action]) {
        return routes[action]();
    } else {
        console.error(`❌ Action '${action}' not recognized by the bridge router.`);
    }
}
