#[cfg(target_arch = "wasm32")]
mod io {
    pub fn stdin() -> Stdin { Stdin }
    pub struct Stdin;

    impl Stdin {
        pub fn read_line(&self, buf: &mut String) -> Result<usize, String> {
            unsafe {
                let msg = "Input required:";
                let ptr = super::newin(msg.as_ptr(), msg.len());

                let mut len = 0;
                while *ptr.add(len) != 0 {
                    len += 1;
                }

                let slice = std::slice::from_raw_parts(ptr, len);
                let result = String::from_utf8_lossy(slice).into_owned();

                let result_len = result.len();
                buf.push_str(&result);
                Ok(result_len)
            }
        }
    }
}
