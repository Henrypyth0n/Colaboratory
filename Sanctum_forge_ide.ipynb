        } finally {
            stat1 = performance.now();
            stat2 = stat1 - stat0;
            console.log(stat0, stat1, stat2);
            //isBusy = false;
        }
    }

// draft 3 improved from draft 2
function runTest(funcName) {
    const fn = currentEngine[funcName];
    const rawInput = document.getElementById('argInput').value;

    let processedArgs = [];
    let isComplex = false;
    let ptr = null;
    let byteLen = 0;
    let displayInput = rawInput; // To keep track for the log message

    // --- 1. DETECT TYPE ---
    if (rawInput.startsWith('"') && rawInput.endsWith('"')) {
        const text = rawInput.slice(1, -1);
        processedArgs = new TextEncoder().encode(text);
        isComplex = true;
    } else if (rawInput.startsWith('[') && rawInput.endsWith(']')) {
        const list = JSON.parse(rawInput);
        processedArgs = new Int32Array(list);
        isComplex = true;
    } else if (rawInput.startsWith('{') && rawInput.endsWith('}')) {
        processedArgs = new TextEncoder().encode(rawInput);
        isComplex = true;
    }
    // Inside your Run Simulation click engine, right before executionWrapper(viewport):
    const codeToCheck = document.getElementById("sandboxJsInput")?.value || "";

    // 🔬 Simple Visual Linter Checks
    if ((codeToCheck.match(/\(/g) || []).length !== (codeToCheck.match(/\)/g) || []).length) {
        viewport.innerHTML = `<span style="color: #ff3333; font-family: monospace;"><b>⚠️ LINTER WARN:</b> Mismatched Parentheses () detected! Check your syntax.</span>`;
        return;
    }
    if ((codeToCheck.match(/\{/g) || []).length !== (codeToCheck.match(/\}/g) || []).length) {
        viewport.innerHTML = `<span style="color: #ff3333; font-family: monospace;"><b>⚠️ LINTER WARN:</b> Mismatched Curly Braces {} detected! Check your event blocks.</span>`;
        return;
    }
    // --- 2. EXECUTE BRIDGE ---
    if (isComplex) {
        byteLen = processedArgs.byteLength;
        ptr = currentEngine.allocate_for_js(byteLen);

        // Log it HERE so 'ptr' isn't null anymore
        console.log(`Memory Allocated at ${ptr} for ${funcName}(${displayInput})`);

        const memory = new Uint8Array(currentEngine.memory.buffer);
        const dataView = new Uint8Array(processedArgs.buffer, processedArgs.byteOffset, byteLen);
        memory.set(dataView, ptr);

        const count = processedArgs.length;
        const result = fn(ptr, count);

        // FIX: Handle void functions that return undefined
        const finalResult = (result !== undefined) ? result : "OK";

        logToSim(`Complex Test: <b>${funcName}</b> -> <b style="color:#f74c00">${finalResult}</b>`);

        if (currentEngine.deallocMemory) {
            currentEngine.deallocMemory(ptr, byteLen);
        }
    } else {
        // SIMPLE NUMBERS
        const args = rawInput.split(',').filter(x => x !== "").map(x => Number(x.trim()));
        const val = fn(...args);

        // FIX: Handle void functions here too
        const finalVal = (val !== undefined) ? val : "OK";

        logToSim(`Executed <b>${funcName}</b> -> <b style="color:#f74c00">${finalVal}</b>`);
    }
}

