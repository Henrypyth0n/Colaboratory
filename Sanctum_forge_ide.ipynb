def update_agent_permissions(js_permissions_json):
  """Receives permission states from frontend, updates booleans, and rebuilds permissions."""
  global GeminiPermissions, PERMISSION_FLAGS

  try:
    perms = json.loads(js_permissions_json)
    active_perms = []

    # Map the UI checkboxes directly to your gatekeeper boolean flags
    PERMISSIONS_FLAGS["write"] = bool(perms.get("Writemode", False))
    PERMISSIONS_FLAGS["read"] = bool(perms.get("Readmode", False))
    PERMISSIONS_FLAGS["execute"] = bool(perms.get("Execmode", False))

    for key, val in PERMISSION_MAP.items():
      if key in perms:
        if perms[key]:
          if isinstance(val, list):
            active_perms.extend(val)
          else:
            active_perms.append(val)
      else:
        if not isinstance(val, list):
          active_perms.append(val)

    GeminiPermissions = active_perms
    return Print(
        f"Permissions updated. Active tool count: {len(GeminiPermissions)} |"
        f" Flags: {PERMISSIONS_FLAGS}"
    )
  except Exception as e:
    return Print(f"Failed to update permissions: {str(e)}")

output.register_callback(
    'colab_update_permissions', update_agent_permissions
)

