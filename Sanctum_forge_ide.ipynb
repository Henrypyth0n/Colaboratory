def run_code_file(filename: str) -> dict:
  """Automatically detects file extension, selects the correct runtime,

  and executes the script safely.
  """
  safe_filename = os.path.basename(filename.replace(".java",'').replace(".class", ''))
  workspace_path = os.path.abspath(
      os.path.join("./", safe_filename)
  )

  if not os.path.exists(workspace_path):
    Print(f"File not found: {safe_filename}")
    return {"status": "error", "message": f"File not found: {safe_filename}"}
  if not PERMISSIONS_FLAGS.get("execute", False):
        Print(f"Execute denied")
        return {"status": "error", "message": f"Execute failed: {filename}"}
  # Map extensions to their exact execution command list
  ext_map = {
      ".py": ["python3"],
      ".js": ["node"],
      ".sh": ["bash"],
      ".rs": ["rustc"],  # or a custom build script path
      ".java": ["java"],
      ".go": ["go", "run"],
  }

  _, ext = os.path.splitext(safe_filename)
  if ext not in ext_map:
    Print(f"Unsupported file extension: {ext}")
    return {
        "status": "error",
        "message": f"Unsupported file extension: {ext}",
    }

  # Build the argument list automatically
  command = ext_map[ext] + [workspace_path]

  try:
    result = subprocess.run(
        command,
        shell=False,
        capture_output=True,
        text=True,
        timeout=5,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin"},
    )
    Print(f"Attempting to run {filename} {datetime.now()}")
    if result.returncode == 0:
      Print(f"Successfully ran {filename} {datetime.now()}")
      Print(f"STDOUT:\n{result.stdout}")
    else:
      Print(f"Failed to run {filename} {datetime.now()}")
      Print(f"STDERR:\n{result.stderr}")
      Print(f"STDOUT:\n{result.stdout}")
    return {
        "status": "success" if result.returncode == 0 else "runtime_error",
        "stdout": result.stdout,
        "stderr": result.stderr,
    }
  except subprocess.TimeoutExpired:
    Print(f"runtime expired {filename} {datetime.now()}")
    return {"status": "timeout", "message": "Execution timed out."}
