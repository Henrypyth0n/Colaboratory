def ensure_target_installed(target_triple):
    # 1. WASM is ready out of the box, skip heavy checks to keep it blazing fast
    if target_triple == "wasm32-unknown-unknown":
        return

    # 2. Ask rustc what targets are actively ready on the system
    installed_targets = !/root/.cargo/bin/rustup target list | grep "(installed)"

    if target_triple not in "".join(installed_targets):
        display(Javascript(f"logToSim('🔧 Zero-Config: Provisioning background layers for __...','#00ddff','simLog')".replace("__",target_triple)))
        triple_target = !/root/.cargo/bin/rustup target add {target_triple}

        #new_yew = !cargo new yew-app #--no-verify
        # 3. Targeted Safety Net: Catch external package links automatically!
        if "windows" in target_triple:
            display(Javascript(f"logToSim('📦 Fetching Windows GNU C-Linker (mingw)...','#00ddff','simLog')"))
            windows_target = !apt-get update -qq && apt-get install -y -qq gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64

        #   install_for_apple = !rustup target add x86_64-apple-darwin && rustup target add aarch64-apple-darwin
        if "android" in target_triple:
            display(Javascript(f"logToSim('📦 Setting up Android NDK environment...','#00ddff','simLog')"))

            # 1. Install required system dependencies
            android_install0 = !apt-get update -qq && apt-get install -y -qq unzip wget

            # 2. Download and Extract Android NDK (r26c) if not already present
            NDK_DIR = "/opt/android-ndk"
            if not os.path.exists(f"{NDK_DIR}/current"):
                display(Javascript(f"logToSim('Downloading and extracting NDK (this happens only once)...','#00ddff','simLog')"))
                os.system("wget -q https://dl.google.com/android/repository/android-ndk-r26c-linux.zip -O /tmp/ndk.zip")
                os.system(f"mkdir -p {NDK_DIR}")
                os.system(f"unzip -q /tmp/ndk.zip -d {NDK_DIR}/")
                # Rename the folder to 'current' for consistency in your path
                os.system(f"mv {NDK_DIR}/android-ndk-r26c {NDK_DIR}/current")
                os.system("apt-get install -y -qq adb")
                os.system("/root/.cargo/bin/cargo install cargo-apk")

            # 3. Add the Android target to Rustup
            os.system(f"rustup target add {target_triple}")

            # 4. Install cargo-ndk for easier builds
            os.system("/root/.cargo/bin/cargo install cargo-ndk")

            display(Javascript(f"logToSim('✅ Android environment ready!','#00ff00','simLog')"))

