// Helper: Tell JS where it can safely write data
#[cfg(target_arch = "wasm32")]
#[no_mangle]
pub extern "C" fn allocate_for_js(len: usize) -> *mut u8 {
    let mut buf = Vec::with_capacity(len);
    let ptr = buf.as_mut_ptr();
    std::mem::forget(buf);
    ptr
}
// a function to realllocate memory for JS or expand it if needed
#[cfg(target_arch = "wasm32")]
#[no_mangle]
pub unsafe extern "C" fn reallocate_for_js(ptr: *mut u8, old_len: usize, new_len: usize) -> *mut u8 {
    // 1. Reconstruct the vector using its current metrics to regain ownership
    let mut buffer = Vec::from_raw_parts(ptr, old_len, old_len);

    // 2. Instruct the native allocator to adjust the capacity
    buffer.resize(new_len, 0); // Fills any new memory slots with neutral 0 bytes

    // 3. Extract the new pointer location (it might be the same, or shifted to an open plot!)
    let new_ptr = buffer.as_mut_ptr();

    // 4. Sever ownership ties again so JS retains control
    std::mem::forget(buffer);

    new_ptr
}
