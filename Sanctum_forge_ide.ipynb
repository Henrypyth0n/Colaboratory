function tabEventListener(tabId='tab6', lang='rust', value="") {
    const tab = document.getElementById(tabId);
    if (tab) {
        tab.addEventListener('change', function(event) {
            if (event.target.checked) {
                // Only run if this ID hasn't been initialized yet
                if (!initializedEditors.has(tabId)) {
                    console.log(`Checkbox is checked! 🟩 Initializing ${tabId} editor...`);
                    lang_linting(`${lang}`, `${value}`, tabId);
                    initializedEditors.add(tabId); // Mark as done
                } else {
                    console.log(`Checkbox is checked! 🟩 ${tabId} editor already active.`);
                }
            } else {
                console.log(`Checkbox is unchecked! 🟥`);
            }
        });
