// an example of bridging strings from js to rust and back again
#[no_mangle]
pub extern "C" fn greet(ptr: *const u8, len: usize) -> i32 {
    // 1. Reconstruct the string from the pointer and length
    let message = unsafe {
        let slice = std::slice::from_raw_parts(ptr, len);
        std::str::from_utf8(slice).unwrap_or("Invalid")
    };

    // 2. Use your existing println bridge to send it back to the UI
    unsafe {
        // Create a new message including the input
        let response = format!("Rust says: {}", message);
        println(response.as_ptr() as *mut u8, response.len());
    }

    // 3. Return a status code (Status Symbol!)
    200
}
