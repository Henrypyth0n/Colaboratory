    function logToSim(msg=0, color="#fff", id='simLog',action="log") {
        const log = document.getElementById(id);
        const entry = document.createElement('div');
        entry.style.color = color;
        if (action === "clr") {
            const log = document.getElementById(id);
            log.innerHTML = "";
        } else if (action === "wasm") {
            // Run this inside your console to see exactly what you have left

            const targetEngine = window.rustEngine || window.currentEngine;
            if (!targetEngine) return;

            const totalBytes = targetEngine.memory.buffer.byteLength;
            const totalMegabytes = totalBytes / (1024 * 1024);
            const totalPages = totalBytes / 65536;
            const maxExpectedPages = 500;
            const loadPercentage = Math.min((totalPages / maxExpectedPages) * 100, 100);
            entry.innerHTML = `<span style="color: #555;">[${new Date().toLocaleTimeString()}]</span> ${msg}<hr>
            <b>📊 DEFAULT WASM THEATER CAPACITY:</b><pre>
➡️ Bytes: ${totalBytes}
➡️ Megabytes: ${totalMegabytes.toFixed(2)} MB
➡️ Wasm Pages: ${totalPages} Pages
📊 Total WASM THEATER CAPACITY:
Raw Bytes Available: ${window.wasmMemory.buffer.byteLength}
True Current Capacity: ${window.wasmMemory.buffer.byteLength / (1024 * 1024)}, "MB"
Physical Page Count: ${WebAssembly.Memory.prototype.grow.call(window.wasmMemory, 0)}
</pre>`
            log.prepend(entry);

        }  else {
            entry.innerHTML = `<span style="color: #555;">[${new Date().toLocaleTimeString()}]</span> ${msg}`;
            log.prepend(entry);
        }
