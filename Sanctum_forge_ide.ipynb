function speak(text) {
  if (!('speechSynthesis' in window)) {
    console.error('Speech synthesis not supported in this environment.');
    return;
  }
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = 'en-US';
  utterance.volume = 1;
  utterance.rate = 1;
  utterance.pitch = 2;
  utterance.text = text;
  window.speechSynthesis.speak(utterance);
}

