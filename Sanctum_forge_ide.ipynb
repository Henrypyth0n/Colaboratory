    const container = document.getElementById(`${id}`);
    //if (!container) return;
    //if (container) return;

    editorRegistry[id] = monaco.editor.create(container, {
        value: `${value}`,
        language: `${lang.toLowerCase()}`,
        theme: `${theme}` // Classic "Dark Mode" fn main() {\n\tprintln!("Hello, Rust!")\n}
    });
    try {
      // 1. Register a new custom language ID with Monaco
      monaco.languages.register({ id: 'cobol' });

      // 2. Define the syntax highlighting tokens using Monarch
      monaco.languages.setMonarchTokensProvider('cobol', {
          keywords: [
              'IDENTIFICATION', 'DIVISION', 'PROGRAM-ID', 'ENVIRONMENT',
              'DATA', 'PROCEDURE', 'WORKING-STORAGE', 'SECTION',
              'PIC', 'COMP', 'DISPLAY', 'ACCEPT', 'STOP', 'RUN', 'PERFORM'
          ],
          tokenizer: {
              root: [
                  // Match custom keywords defined above
                  [/[a-zA-Z\-]+/, {
                      cases: {
                          '@keywords': 'keyword',
                          '@default': 'identifier'
                      }
                  }],
                  // Basic number highlighting
                  [/\d+/, 'number'],
                  // Basic comment string tracking (COBOL uses an asterisk in column 7)
                  [/^\*{1}.*$/, 'comment'],
                  // String literal matching
                  [/"([^"\\]|\\.)*"/, 'string'],
              ]
          }
      });
    } catch (error) {
        console.error('Error registering COBOL language:', error);
    }
});
}

