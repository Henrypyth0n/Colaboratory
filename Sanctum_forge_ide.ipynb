def export_workspace_payload(rust_src, html_src, js_src):
    try:
        # Define a clean target directory directly in /content/
        target_dir = '/content/wasm_exported_app'
        src_dir = os.path.join(target_dir, 'src')
        os.makedirs(src_dir, exist_ok=True)

        # Write out your decoupled frontend presentation layers
        with open(os.path.join(target_dir, 'index.html'), 'w', encoding='utf-8') as f:
            f.write(html_src)

        with open(os.path.join(target_dir, 'script.js'), 'w', encoding='utf-8') as f:
            f.write(js_src)

        # Write out your underlying systems logic layer
        with open(os.path.join(src_dir, 'lib.rs'), 'w', encoding='utf-8') as f:
            f.write(rust_src)

        # Drop a default Cargo blueprint file if one does not exist yet
        cargo_path = os.path.join(target_dir, 'Cargo.toml')
        if not os.path.exists(cargo_path):
            with open(cargo_path, 'w', encoding='utf-8') as f:
                f.write("[package]\nname = \"wasm_engine\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n")

        return JSON({'status': 'SUCCESS', 'path': target_dir})
    except Exception as e:
        return JSON({'status': 'ERROR', 'message': str(e)})

# Open the API communication bridge channel for your JavaScript frontend
output.register_callback('notebook.export_project_files', export_workspace_payload)
