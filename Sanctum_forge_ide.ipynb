def compile_rust_logic(rust_source): # args
    global CURRENT_TARGET

    # 1. Clean up old files so we don't get "False Success"
    if os.path.exists("my_engine.wasm"):
        os.remove("my_engine.wasm")
    for file in ["my_engine.wasm", "app_output", "app_output.so"]:
        if os.path.exists(file): os.remove(file)

    compiled_path = "target/wasm32-unknown-unknown/release/rust_wasm_forge_core.wasm"
    if os.path.exists(compiled_path):
       os.remove(compiled_path)

    # 2. Save the user's code
    with open("lib.rs", "w") as f:
        f.write(rust_source)
    os.makedirs("src", exist_ok=True)
    with open("src/lib.rs", "w") as f:
      f.write(rust_source)

    #colored = "2.0.0"
    # 3. RUN THE COMPILER (Capture everything in 'result')
    # Removed the second 'error =' line that was causing the ghost failure
    if CURRENT_TARGET == "wasm32-unknown-unknown":
        # --- BROWSER / WASM ---
        result0 = !/root/.cargo/bin/rustc --color never --target wasm32-unknown-unknown --crate-type=cdylib -O lib.rs -o my_engine.wasm 2>&1
        result1 = !/root/.cargo/bin/cargo build --color never --target wasm32-unknown-unknown --release 2>&1

        if os.path.exists("my_engine.wasm"): return "SUCCESS"
        if os.path.exists(compiled_path):
            shutil.copy(compiled_path, "my_engine.wasm")
            return "SUCCESS"
        return '\n'.join(result0) + '\n' + '\n'.join(result1)

    elif CURRENT_TARGET == "x86_64-unknown-linux-gnu":
        # --- LINUX OS BINARY ---
        result0 = !/root/.cargo/bin/rustc --color never --crate-type=bin -O lib.rs -o linux_binary 2>&1
        if os.path.exists("linux_binary"):
            return "SUCCESS: Native Linux OS Binary 'linux_binary' Compiled!"
        return '\n'.join(result0)
    elif "windows" in CURRENT_TARGET:
        # --- WINDOWS COMPILATION (.exe) ---
        result0 = !/root/.cargo/bin/rustc --color never --target {CURRENT_TARGET} --crate-type=bin -O lib.rs -o win_app.exe 2>&1
        if os.path.exists("win_app.exe"):
            instructions = r"<br> Make sure to cd into the directory it is in example: <br>cd Downloads <br>then <br>replace | with a backslash .|file_name.exe <br>to run"
            display(Javascript(r"logToSim(`__`,'#00ddff','simLog');".replace("__",instructions)))
            return "SUCCESS: Windows Executable 'win_app.exe' Ready! Go to your Colab file explorer sidebar to download it."
        return '\n'.join(result0)

    elif any(x in CURRENT_TARGET for x in ["apple", "macos"]): #"apple" in CURRENT_TARGET:
        # --- MACOS COMPILATION ---
        linker_flag = "-C linker=rust-lld"
        result0 = !/root/.cargo/bin/rustc {linker_flag} --color never --target {CURRENT_TARGET} --crate-type=bin -O lib.rs -o app_output_mac 2>&1
        if os.path.exists("app_output_mac"):
            instructions = "<br>💡 To run this on your Mac:<br>1. Open Terminal<br>2. Run: cd Downloads (or the directory containing the file)<br>3. Run: chmod +x app_output_mac (gives execution permission)<br>4. Run: ./app_output_mac"
            display(Javascript(r"logToSim(`__`,'#00ddff','simLog')".replace("__",instructions)))
            return f"SUCCESS: macOS Binary 'app_output_mac' Ready for {CURRENT_TARGET}!"
        return '\n'.join(result0)
    elif "android" in CURRENT_TARGET:
        # --- ANDROID NATIVE CROSS-COMPILATION ---
        # Old code for rustc simpler
        NDK_BIN = "/opt/android-ndk/current/toolchains/llvm/prebuilt/linux-x86_64/bin"
        CLANG_PATH = f"{NDK_BIN}/{CURRENT_TARGET.split('-')[0]}-linux-android29-clang"

        # Add the -C linker argument to force rustc to use the NDK Clang
        cmd = [
            "/root/.cargo/bin/rustc",
            "--color", "never",
            "--target", CURRENT_TARGET,
            "--crate-type=cdylib",
            "-O", "lib.rs",
            "-o", "app_output.so",
            "-C", f"linker={CLANG_PATH}"  # <--- THIS IS THE KEY
        ]#
        process0 = subprocess.run(cmd, capture_output=True, text=True)
        #process0 = subprocess.Popen(
        #    cmd,
        #    stdout=subprocess.PIPE,
        #    stderr=subprocess.PIPE,
        #    text=True
        #)
        #new cargo code both rustc / cargo work
        # 1. Get the path to your linker
        #LINKER_PATH = "/opt/android-ndk/current/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android29-clang"

        # 2. Tell Cargo specifically to use this for your target
        # The syntax is CARGO_TARGET_<TARGET_TRIPLE>_LINKER
        # We need to replace '-' with '_' and uppercase it
        #env = os.environ.copy()
        #target_env = f"CARGO_TARGET_{CURRENT_TARGET.replace('-', '_').upper()}_LINKER"
        #env[target_env] = LINKER_PATH
        # Before you add your custom linker

        # 3. Now run the build
        #cmd = [
        #    "/root/.cargo/bin/cargo",
        #    "build",
        #    "--release",
        #    "--target", CURRENT_TARGET
        #]
        # ADD 'env=env' HERE
        #process0 = subprocess.run(cmd, env=env, capture_output=True, text=True)
        if process0.returncode == 0:
            return f"SUCCESS: Native Android Library 'app_output.so' Compiled for {CURRENT_TARGET}!"
        else:
            link_tip = "\n💡 TIP: Run a Bash cell to download the Android NDK Toolchain linker to cross-compile for mobile devices!"
            return f"FAILED:\n{process0.stderr} \n{link_tip}"
        display(Javascript(r"logToSim('Downloading Android NDK...','#00ddff','simLog')"))



    elif CURRENT_TARGET == "yew-framework":
      display(Javascript(f"logToSim('📦 Provisioning Yew Project Environment...')"))

      # 1. Zero-Config: Ensure the Trunk bundle tool is installed on the server
      if not os.path.exists("/root/.cargo/bin/trunk"):
         trunk =   !cargo add trunk #--no-verify
         steps0 =  !/root/.cargo/bin/cargo install --locked trunk
         steps1 =  !/root/.cargo/bin/rustup target add wasm32-unknown-unknown
         steps2 =  !/root/.cargo/bin/cargo build --color never --target wasm32-unknown-unknown --release 2>&1
      # 2. Automatically stitch together a valid Cargo.toml with the Yew dependencies
      yew_toml = """
      [package]
      name = "yew-app"
      version = "0.1.0"
      edition = "2021"

      [dependencies]
      yew = { version = "0.21", features = ["csr"] }
      """
      with open("Cargo.toml", "w") as f:
          f.write(yew_toml)

      # 3. Create a clean index.html file that Trunk expects as an entry point
      yew_html = """
      <!DOCTYPE html>
      <html>
          <head><meta charset="utf-8" /><title>Yew App</title></head>
          <body></body>
      </html>
      """
      with open("index.html", "w") as f:
          f.write(yew_html)

      # 4. Save your code into the standard src directory layout
      os.makedirs("src", exist_ok=True)
      with open("src/main.rs", "w") as f:
          f.write(rust_source)

      # 5. Run Trunk Build instead of raw rustc flags!
      result = !/root/.cargo/bin/trunk build --release 2>&1

      # Trunk outputs files into the "dist" folder
      if os.path.exists("dist"):
          return "SUCCESS: Yew Framework Application Built! Serving static files from /dist."
      else:
          return '\n'.join(result)
    #result0 = !/root/.cargo/bin/rustc --color never --target wasm32-unknown-unknown --crate-type=cdylib -O lib.rs -o my_engine.wasm 2>&1
    #result1 = !/root/.cargo/bin/cargo build --color never --target wasm32-unknown-unknown --release 2>&1

    # 4. CHECK THE RESULT
    if os.path.exists("my_engine.wasm"):
        return "SUCCESS"
    if os.path.exists(compiled_path):
        # Bring the finished engine out to the root folder so your JavaScript can call it
        shutil.copy(compiled_path, "my_engine.wasm")
        return "SUCCESS"
    else:
        # If the file doesn't exist, 'result' contains the full Rust Error message
        return '\n'.join(result0) + '\n' + '\n'.join(result1)

