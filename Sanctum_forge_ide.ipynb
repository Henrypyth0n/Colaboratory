// OPTIONAL: Example of how you would trigger your clear function via JS
function runClearTest() {
    if (window.activeTestPointers.length > 0) {
        // Pop the last 1 KB pointer address block off our stack array
        const ptrToClear = window.activeTestPointers.pop();

        // Invoke the low-level Rust de-allocator
        window.rustEngine.clear_leaked_memory_buffer(ptrToClear, 1024);

        // Immediately refresh the telemetry status card view
        updateWasmHealthTelemetry();
    }
}
