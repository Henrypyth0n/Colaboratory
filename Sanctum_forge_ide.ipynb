let db;
let openRequest = indexedDB.open("RSDATA", 1);

openRequest.onupgradeneeded = (event) => {
    db = event.target.result;
    if (!db.objectStoreNames.contains("rsLog")) {
        db.createObjectStore("rsLog", { keyPath: "id" });
    }
};

openRequest.onsuccess = (event) => {
    db = event.target.result;
    window.db = db; // Global handle for your console debugging
    console.log("Forge Storage: ONLINE");
};
async function loadFromDB(key) {
    return new Promise((resolve, reject) => {
        const request = window.db.transaction("rsLog", "readonly").objectStore("rsLog").get(key);
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
    });
}


