#[cfg(target_arch = "wasm32")]
#[wasm_bindgen(start)] // This makes the function auto-run the second JavaScript loads the WASM file
pub fn run_in_browser() -> Result<(), JsValue> {
    // Run the same shared logic engine
    let profit = core_accounting_logic(5000.0, 2300.0);

    // Safely reach out and manipulate the webpage DOM
    let window = window().ok_or("No global window found")?;
    let document = window.document().ok_or("No document found on window")?;

    // Looks for an HTML element with id="output" (e.g., <div id="output"></div>)
    if let Some(display_element) = document.get_element_by_id("output") {
        display_element.set_inner_html(&format!("WebAssembly Profit Result: ${:.2}", profit));
    }

    Ok(())
}
use aes_gcm::{Aes256Gcm, Key, Nonce};
use aes_gcm::aead::{Aead, KeyInit};

// =========================================================================
// 🔒 AES-GCM 256-BIT ENCRYPTION ENGINE
// =========================================================================
#[no_mangle]
pub extern "C" fn encrypt_secret_packet() -> i32 {
    let key_bytes = [0u8; 32];
    let key = Key::&lt;Aes256Gcm&gt;::from_slice(&key_bytes);

    let cipher = Aes256Gcm::new(key);

    let nonce_bytes = [0u8; 12];
    let nonce = Nonce::from_slice(&nonce_bytes);

    let plaintext = b"CONFIDENTIAL_PACKET_BALANCE_$5000";

    match cipher.encrypt(nonce, plaintext.as_ref()) {
        Ok(_ciphertext) => 1,
        Err(_) => 0
    }
}

