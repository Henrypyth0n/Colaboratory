            const result = await google.colab.kernel.invokeFunction('notebook.CompileGo', [document.getElementById("goCode").value || editorRegistry['goCode'].getValue()], {});
            const response = result.data['application/json'];

            if (response.error) {
                term.innerHTML = "<span style='color:red'>COMPILER ERROR:</span>\n" + response.error;
            } else {
                term.innerHTML = "Binary received. Executing...";
                await startWasm(response.wasm);
            }
        } catch (e) {
            term.innerHTML = "<span style='color:red'>BRIDGE ERROR:</span>\n" + e.message + "\n\nTry re-running Step 1 (The GO Compiler Engine Room).\n or connect to wifi";
        }
    }

    async function startWasm(b64) {
        const go = new Go();
        const bin = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
        const { instance } = await WebAssembly.instantiate(bin, go.importObject);
        await go.run(instance);
        document.getElementById("goTerminal").innerHTML = "<b>GO OUTPUT:</b> " + (window.goResult || "Success!");
    }
