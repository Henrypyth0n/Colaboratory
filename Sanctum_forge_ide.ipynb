def compile_go_service(source_code):
    try:
        # 1. Write Go source to disk
        with open("main.go", "w") as f:
            f.write(source_code)

        # 2. Compile to WASM (Ensure Go is installed via !apt-get install golang-go)
        status = os.system("GOOS=js GOARCH=wasm go build -o main.wasm main.go 2> err.txt")

        if status != 0:
            with open("err.txt", "r") as f:
                return IPython.display.JSON({"error": f.read()})

        # 3. Read binary and encode to Base64
        with open("main.wasm", "rb") as f:
            encoded = base64.b64encode(f.read()).decode('utf-8')
            return IPython.display.JSON({"wasm": encoded})

    except Exception as e:
        return IPython.display.JSON({"error": str(e)})

# Register the callback name clearly
output.register_callback('notebook.CompileGo', compile_go_service)

