function createProgressBar(percent, usedBytes) {
    const totalBars = 20; // Length of the bar
    const filled = Math.round((percent / 100) * totalBars);
    const empty = totalBars - filled;
    const bar = "█".repeat(filled) + "░".repeat(empty);
    const mbUsed = (usedBytes / (1024 * 1024)).toFixed(2);

    return `[${bar}] ${percent.toFixed(0)}% | ${mbUsed} MB used`;
}
