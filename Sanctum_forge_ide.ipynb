// rootAccess(rustEngine) , ptr,     lenght, content
function writeStringToRust(jsString) {
    // 1. Resolve whichever engine namespace is active
    const targetEngine = window.rustEngine || window.currentEngine;
    if (!targetEngine) return;

    const textToSend = jsString;

    // 2. Encode the text to get raw bytes and exact length
    const encoder = new TextEncoder();
    const encodedBytes = encoder.encode(textToSend);
    const len = encodedBytes.length;

    // 3. Let Rust pick a safe, open address number dynamically
    const dynamicPointer = targetEngine.allocate_for_js(len);

    // 4. Open up a direct window over the live memory exports buffer
    const rawMemoryBuffer = targetEngine.memory.buffer;

    // 5. Target the EXACT allocated address slot safely
    const memoryLockerZone = new Uint8Array(rawMemoryBuffer, dynamicPointer, len);
    memoryLockerZone.set(encodedBytes); // .set() places the str in that slot

    console.log(`⚡ Blasted "${textToSend}" directly into dynamic address: [${dynamicPointer}]`);

    // 6. Tell Rust exactly where to look and how many bytes to read
    targetEngine.process_string(dynamicPointer, len);
    targetEngine.deallocMemory(dynamicPointer, len);
    // to mod data you target by index memoryLockerZone[0] = new_value
    // to get data you get it by index too
    // now to mod a str you need the codes to repsent the letter youre trying to pass or use "a".harCodeAt(0); finds the code automatically
    // you can use .set(encodedText) to repurpose the entire slot
};// --------------------------------------------------------------------------------------------------------
