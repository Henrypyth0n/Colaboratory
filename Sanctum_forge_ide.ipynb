def run_binary_with_args(binary_path: str, arg_list: list[str]):
    # Construct the execution command safely as a list
    cmd = [binary_path] + arg_list

    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=5 # Prevent infinite loops in experimental code
    )

    if result.returncode == 0:
        return f"STDOUT:\n{result.stdout}"
    else:
        return f"ERROR (Exit {result.returncode}):\n{result.stderr}"
